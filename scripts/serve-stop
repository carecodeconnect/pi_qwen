#!/usr/bin/env bash
set -euo pipefail

# Stop whatever llama-server is currently holding the port (default 8080).
# Useful when switching between qwen-serve / gptoss-serve / glmair-serve,
# since only one server can bind the port at a time.

PORT="${PORT:-8080}"

pids=$(lsof -i ":${PORT}" -t 2>/dev/null || true)

if [[ -z "$pids" ]]; then
  echo "port ${PORT} already free"
  exit 0
fi

echo "stopping pid(s): $pids on port ${PORT}"
kill $pids 2>/dev/null || true

# Give it a moment to shut down cleanly, then force if needed.
for _ in 1 2 3 4 5; do
  sleep 1
  if [[ -z "$(lsof -i ":${PORT}" -t 2>/dev/null)" ]]; then
    echo "port ${PORT} free"
    exit 0
  fi
done

echo "still alive, sending SIGKILL"
lsof -i ":${PORT}" -t | xargs kill -9 2>/dev/null || true
sleep 1
lsof -i ":${PORT}" 2>/dev/null | head -3 || echo "port ${PORT} free"
