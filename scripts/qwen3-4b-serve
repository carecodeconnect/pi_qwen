#!/usr/bin/env bash
# Qwen3-4B-Instruct-2507 served via llama.cpp, tuned for low-spec Linux/CPU.
# Defaults target a ThinkPad X270 (i7-7600U, 14 GiB, no GPU) — see docs/12-linux-cpu.md.
# This is the recommended X270 default for pi agent loops: Qwen2.5-Coder-3B
# under-follows the <tool_call> format with tool_choice=auto; Qwen3-4B-2507 is
# the smallest model that reliably emits structured tool calls at this size.
# Override any of MODEL/HOST/PORT/CTX/ALIAS/NGL/THREADS via env.
set -euo pipefail

MODEL="${MODEL:-$HOME/models/qwen3-4b-instruct-2507/Qwen3-4B-Instruct-2507-Q4_K_M.gguf}"
HOST="${HOST:-127.0.0.1}"
PORT="${PORT:-8080}"
CTX="${CTX:-16384}"
ALIAS="${ALIAS:-local-qwen3-4b-instruct-2507}"
NGL="${NGL:-0}"
THREADS="${THREADS:-4}"
# Override the GGUF-embedded template with Qwen's official one (fetched by
# install/qwen3-4b.sh). Same rationale as qwen-serve and qwen-coder-3b-serve:
# the embedded template's tool-call emission is often slightly off and breaks
# llama-server's tool_calls parser.
CHAT_TEMPLATE="${CHAT_TEMPLATE:-$HOME/models/qwen3-4b-instruct-2507/templates/qwen3-4b-official.jinja}"

if [[ ! -f "$MODEL" ]]; then
  echo "error: model not found at $MODEL" >&2
  echo "       run install/qwen3-4b.sh first, or set MODEL=/path/to/file.gguf" >&2
  exit 1
fi

TEMPLATE_ARGS=()
if [[ -f "$CHAT_TEMPLATE" ]]; then
  TEMPLATE_ARGS=(--chat-template-file "$CHAT_TEMPLATE")
else
  echo "warning: chat template not found at $CHAT_TEMPLATE" >&2
  echo "         falling back to GGUF-embedded template — tool calling may be unreliable" >&2
  echo "         re-run install/qwen3-4b.sh to fetch it" >&2
fi

exec llama-server \
  -m "$MODEL" \
  --host "$HOST" --port "$PORT" \
  -ngl "$NGL" -c "$CTX" -t "$THREADS" --jinja \
  "${TEMPLATE_ARGS[@]}" \
  --temp 0.7 --top-p 0.8 --top-k 20 --repeat-penalty 1.05 \
  -a "$ALIAS"
