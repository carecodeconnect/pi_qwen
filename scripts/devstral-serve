#!/usr/bin/env bash
set -euo pipefail

# Devstral-Small-2507 (Mistral × All Hands AI). Agent-tuned 24B dense.
# Tool calling uses the GGUF's embedded Mistral chat template — no override
# needed, just --jinja. Mistral recommends temp 0.15 for deterministic agent
# behavior (lower than Qwen's 0.6).

MODEL="${MODEL:-$HOME/models/devstral-small-2507/Devstral-Small-2507-UD-Q5_K_XL.gguf}"
HOST="${HOST:-127.0.0.1}"
PORT="${PORT:-8080}"
CTX="${CTX:-131072}"
ALIAS="${ALIAS:-devstral-small-2507}"

if [[ ! -f "$MODEL" ]]; then
  echo "error: model not found at $MODEL" >&2
  echo "set MODEL=/path/to/file.gguf to override, or download with:" >&2
  echo "  HF_HUB_ENABLE_HF_TRANSFER=1 hf download unsloth/Devstral-Small-2507-GGUF \\" >&2
  echo "    Devstral-Small-2507-UD-Q5_K_XL.gguf --local-dir ~/models/devstral-small-2507" >&2
  exit 1
fi

exec llama-server \
  -m "$MODEL" \
  --host "$HOST" --port "$PORT" \
  -ngl 99 -c "$CTX" -fa on --jinja \
  --temp 0.15 \
  -a "$ALIAS"
