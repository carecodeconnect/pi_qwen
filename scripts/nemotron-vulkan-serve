#!/usr/bin/env bash
# Llama-3.1-Nemotron-Nano served via prebuilt Vulkan llama.cpp on the ThinkPad P53.
# Hardware: Quadro RTX 4000 Mobile, 8 GB VRAM, Turing (compute 7.5). See docs/13-p53-vulkan-gpu.md.
#
# Why Vulkan, not CUDA: this host's CUDA toolkit (12.3) is too old for Ubuntu 26.04's
# glibc — nvcc cannot compile against the system headers with any installed gcc (12-15),
# and ggml-org/llama.cpp ships NO prebuilt CUDA-Linux binary. The prebuilt *Vulkan* build
# runs on the same NVIDIA GPU with no CUDA toolchain at all, and it is the same
# llama-server, so pi's `local-llamacpp` provider (:8080) is unchanged.
# Install the binary + GGUFs with: install/nemotron-vulkan.sh
#
# Tool calling: we DON'T use the GGUF-embedded Nemotron template — it raises
# "Conversation roles must alternate" on the non-alternating message sequences pi's
# agent loop produces (tool results + context compaction), and llama-server can't
# auto-generate a tool parser from it. Instead we pass llama.cpp's canonical
# meta-llama-Llama-3.1-8B-Instruct.jinja (the Nano models are Llama-3.1-derived, same
# tokenizer) via --chat-template-file. It's lenient on roles and tested with the tool
# parser. Fetched by install/nemotron-vulkan.sh. The single-turn weather test passes
# under the embedded template too, but multi-turn agentic use needs this one.
#
# Reasoning vs instruct: Nemotron-Nano is ONE checkpoint with a runtime toggle — the system
# directive "detailed thinking off" puts it in non-reasoning (instruct) mode, which is what you
# want for pi's agent loop (reasoning mode over-thinks and makes erratic tool calls; see
# docs/13 "Agent verdict"). pi doesn't send that directive, so we FORCE it: the default template
# (nemotron-nano-instruct.jinja) injects "detailed thinking off" into the system block, and we
# use GREEDY decoding (--temp 0), NVIDIA's recommended setting for thinking-off. Set THINK=on to
# run reasoning mode (temp 0.6, plain template) instead.
#
# Override MODEL/ALIAS/CTX/PORT/BIN_DIR/GGML_VK_VISIBLE_DEVICES/THINK via env.
set -uo pipefail

BIN_DIR="${BIN_DIR:-$HOME/llama-vulkan/llama-b9581}"
MODEL="${MODEL:-$HOME/models/nemotron-nano-8b-Q4_K_M.gguf}"
ALIAS="${ALIAS:-nemotron-nano-8b}"
HOST="${HOST:-127.0.0.1}"
PORT="${PORT:-8080}"
# 8B Q4 (~4.9 GB) on 8 GB VRAM: keep ctx modest so the KV cache fits. 16384 with
# -fa on leaves headroom; raise CTX or add --cache-type-k q8_0 --cache-type-v q8_0
# to stretch context further at negligible quality cost. The 4B leaves much more room.
CTX="${CTX:-16384}"
LOG="${LOG:-/tmp/nemotron-serve.log}"
THINK="${THINK:-off}"   # off = instruct mode (greedy + forced "detailed thinking off"); on = reasoning
# Template: instruct one forces "detailed thinking off"; reasoning one is the plain Llama-3.1 tools.
if [[ "$THINK" == "on" ]]; then
  CHAT_TEMPLATE="${CHAT_TEMPLATE:-$HOME/models/templates/llama-3.1-instruct-tools.jinja}"
  SAMPLING=(--temp 0.6 --top-p 0.95 --top-k 20)
else
  # Nemotron's OWN template (native <AVAILABLE_TOOLS>/<TOOLCALL> tool format), patched to drop the
  # role-alternation raise and force "detailed thinking off". Best available tool-calling path —
  # but note llama.cpp's Llama-3.x-Nemotron tool parser is still UNMERGED (PR #15083) and the
  # "Failed to parse input" error is a known open bug (#20650), so calls may still mangle.
  # Fall back to the Llama-3.1 template by setting CHAT_TEMPLATE=...nemotron-nano-instruct.jinja.
  CHAT_TEMPLATE="${CHAT_TEMPLATE:-$HOME/models/templates/nemotron-native-instruct.jinja}"
  SAMPLING=(--temp 0)   # greedy — NVIDIA's recommended setting for "detailed thinking off"
fi

if [[ ! -x "$BIN_DIR/llama-server" ]]; then
  echo "error: Vulkan llama-server not at $BIN_DIR — run install/nemotron-vulkan.sh" >&2; exit 1
fi
if [[ ! -f "$MODEL" ]]; then
  echo "error: model not found at $MODEL — run install/nemotron-vulkan.sh" >&2; exit 1
fi

TEMPLATE_ARGS=()
if [[ -n "$CHAT_TEMPLATE" && -f "$CHAT_TEMPLATE" ]]; then
  TEMPLATE_ARGS=(--chat-template-file "$CHAT_TEMPLATE")
else
  echo "warning: chat template not found at $CHAT_TEMPLATE — falling back to the GGUF-embedded" >&2
  echo "         Nemotron template, which BREAKS pi's multi-turn agent loop (role-alternation" >&2
  echo "         raise). Run install/nemotron-vulkan.sh to fetch it." >&2
fi

export LD_LIBRARY_PATH="$BIN_DIR"
# Select the Quadro (Vulkan device index 1; index 0 is the Intel UHD 630 iGPU).
export GGML_VK_VISIBLE_DEVICES="${GGML_VK_VISIBLE_DEVICES:-1}"

echo "serving $ALIAS on $HOST:$PORT  (ctx=$CTX, THINK=$THINK, Vulkan/Quadro RTX 4000)  log=$LOG"
"$BIN_DIR/llama-server" \
  -m "$MODEL" \
  --host "$HOST" --port "$PORT" \
  -ngl 99 -c "$CTX" -fa on --jinja \
  "${TEMPLATE_ARGS[@]}" \
  "${SAMPLING[@]}" \
  -a "$ALIAS" 2>&1 | tee "$LOG"
