#!/usr/bin/env bash
set -euo pipefail

# Qwen3-Coder-Next-80B-A3B-Instruct. 80 B MoE, ~3 B active. Scaled-up
# sibling of the Qwen3-Coder-30B-A3B default — same coder-tuning, same
# 3 B active params, same template/tool-call wiring, just larger total
# capacity. 256 K native context (extendable to 1 M via YaRN).
#
# Quant: Q3_K_M (~38 GB) — closest to the "~35–40 GB target with real
# headroom" goal. Fits under the default 44 GB Metal wired-memory cap
# on a 64 GB Mac with no sysctl bump needed (unlike GLM-4.5-Air).
#
# Tool calling: same fix as qwen-serve — fetch Qwen's official chat
# template via the upstream tokenizer_config.json (the Unsloth GGUF
# ships an embedded template with the same tool-call format bug as
# Qwen3-Coder-30B). Use the env-var overrides on fetch-template:
#
#   DEST_DIR=~/models/qwen3-coder-next/templates \
#   DEST=$DEST_DIR/qwen3-next-official.jinja \
#   TOKCONF_URL=https://huggingface.co/Qwen/Qwen3-Next-80B-A3B-Instruct/resolve/main/tokenizer_config.json \
#   fetch-template
#
# Sampling: Qwen's official recipe (same as Qwen3-Coder-30B).

MODEL="${MODEL:-$HOME/models/qwen3-coder-next/Qwen3-Coder-Next-Q3_K_M.gguf}"
HOST="${HOST:-127.0.0.1}"
PORT="${PORT:-8080}"
CTX="${CTX:-131072}"
ALIAS="${ALIAS:-local-qwen3-coder-next}"
CHAT_TEMPLATE="${CHAT_TEMPLATE:-$HOME/models/qwen3-coder-next/templates/qwen3-next-official.jinja}"

if [[ ! -f "$MODEL" ]]; then
  echo "error: model not found at $MODEL" >&2
  echo "set MODEL=/path/to/file.gguf to override, or download with:" >&2
  echo "  HF_HUB_ENABLE_HF_TRANSFER=1 hf download unsloth/Qwen3-Coder-Next-GGUF \\" >&2
  echo "    Qwen3-Coder-Next-Q3_K_M.gguf --local-dir ~/models/qwen3-coder-next" >&2
  exit 1
fi

TEMPLATE_ARGS=()
if [[ -f "$CHAT_TEMPLATE" ]]; then
  TEMPLATE_ARGS=(--chat-template-file "$CHAT_TEMPLATE")
else
  echo "warning: chat template not found at $CHAT_TEMPLATE" >&2
  echo "         falling back to GGUF-embedded template — tool calling will be unreliable" >&2
  echo "         fetch it with the env-var overrides documented in this script header" >&2
fi

exec llama-server \
  -m "$MODEL" \
  --host "$HOST" --port "$PORT" \
  -ngl 99 -c "$CTX" -fa on --jinja \
  --cache-type-k q8_0 --cache-type-v q8_0 \
  "${TEMPLATE_ARGS[@]}" \
  --temp 0.6 --top-p 0.95 --top-k 20 \
  -a "$ALIAS"
